{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "var(--cw-width-standard)",
            "wideSize": "var(--cw-width-wide)"
        },
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultPalette": false,
            "palette": [
                { "slug": "white", "color": "var(--cw-color-white)", "name": "White" },
                { "slug": "light", "color": "var(--cw-color-light)", "name": "Light" },
                { "slug": "dark", "color": "var(--cw-color-dark)", "name": "Dark" },
                { "slug": "brand", "color": "var(--cw-color-brand)", "name": "Brand" },
                { "slug": "brand-light", "color": "var(--cw-color-brand-light)", "name": "Brand Light" },
                { "slug": "brand-dark", "color": "var(--cw-color-brand-dark)", "name": "Brand Dark" },
                { "slug": "muted", "color": "var(--cw-color-muted)", "name": "Muted" },
                { "slug": "info", "color": "var(--cw-color-info)", "name": "Info" },
                { "slug": "success", "color": "var(--cw-color-success)", "name": "Success" },
                { "slug": "danger", "color": "var(--cw-color-danger)", "name": "Danger" },
                { "slug": "accent-1", "color": "var(--cw-color-accent-1)", "name": "Accent 1" },
                { "slug": "accent-2", "color": "var(--cw-color-accent-2)", "name": "Accent 2" },
                { "slug": "accent-3", "color": "var(--cw-color-accent-3)", "name": "Accent 3" }
            ]
        },
        "typography": {
            "fontSize": false,
            "dropCap": false,
            "customFontSize": false,
            "fontStyle": false,
            "lineHeight": false,
            "letterSpacing": false,
            "textTransform": false,
            "textDecoration": false
        },
        "spacing": {
            "padding": false,
            "margin": false,
            "blockGap": true,
            "units": ["rem", "em", "px", "vh", "vw", "%"]
        }
    },
    "styles": {
        "color": {
            "background": "var(--cw-color-bg)",
            "text": "var(--cw-color-text)"
        },
        "typography": {
            "fontFamily": "var(--cw-font-body)",
            "fontSize": "1rem",
            "lineHeight": "1.6"
        },
        "elements": {
            "h1": {
                "fontFamily": "var(--cw-font-heading)",
                "fontWeight": "700",
                "fontSize": "clamp(2.25rem, 3.8vw, 3.5rem)",
                "lineHeight": "1.1",
                "letterSpacing": "-0.02em"
            },
            "h2": {
                "fontFamily": "var(--cw-font-heading)",
                "fontWeight": "600",
                "fontSize": "clamp(1.875rem, 3vw, 2.75rem)",
                "lineHeight": "1.2",
                "letterSpacing": "-0.01em"
            },
            "h3": {
                "fontFamily": "var(--cw-font-heading)",
                "fontWeight": "600",
                "fontSize": "clamp(1.375rem, 2vw, 2rem)",
                "lineHeight": "1.3"
            },
            "link": {
                "color": "var(--cw-color-brand)",
                "textDecoration": "underline",
                "textDecorationThickness": "1px",
                "textUnderlineOffset": "0.15em"
            }
        },
        "blocks": {
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--cw-font-body)",
                    "fontSize": "1rem",
                    "fontWeight": "500"
                },
                "spacing": {
                    "blockGap": "1.5rem"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "showcase",
            "title": "Showcase",
            "postTypes": ["page"]
        }
    ],
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}
