{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cinderwell-popups/trigger",
  "title": "Popup Trigger",
  "category": "cinderwell-popups",
  "icon": "format-chat",
  "description": "Button that opens a published popup.",
  "supports": {
    "align": false,
    "color": false,
    "typography": false,
    "spacing": false,
    "html": false,
    "reusable": true
  },
  "attributes": {
    "text": { "type": "string", "default": "Open popup" },
    "popupId": { "type": "integer", "default": 0 },
    "variant": { "type": "string", "default": "primary" },
    "size": { "type": "string", "default": "md" }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
