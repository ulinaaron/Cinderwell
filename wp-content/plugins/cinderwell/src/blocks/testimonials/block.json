{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/testimonials",
    "title": "Testimonials",
    "category": "cinderwell",
    "icon": "format-quote",
    "description": "Present client testimonials as responsive cards or an accessible carousel.",
    "supports": {
        "align": [ "wide", "full" ], "align_text": false, "align_content": false,
        "color": false, "typography": false, "spacing": false, "border": false,
        "anchor": false, "customClassName": false, "html": false, "multiple": true, "reusable": true
    },
    "attributes": {
        "dynamicData": { "type": "object", "default": {} },
        "conditions": { "type": "object", "default": {} },
        "visibility": { "type": "string", "default": "always" },
        "visibilityConfig": { "type": "object", "default": {} },
        "eyebrow": { "type": "string", "default": "" },
        "showEyebrow": { "type": "boolean", "default": false },
        "heading": { "type": "string", "default": "" },
        "showHeading": { "type": "boolean", "default": true },
        "headingLevel": { "type": "integer", "default": 2 },
        "testimonials": { "type": "array", "default": [ { "id": "testimonial-1", "quote": "", "name": "", "role": "", "organization": "", "image": 0, "imageUrl": "", "imageAlt": "", "imageWidth": 0, "imageHeight": 0 } ] },
        "layout": { "type": "string", "default": "cards" },
        "columns": { "type": "string", "default": "3" },
        "columnsTablet": { "type": "string", "default": "" },
        "columnsMobile": { "type": "string", "default": "" },
        "cardColor": { "type": "string", "default": "white" },
        "photoShape": { "type": "string", "default": "circle" },
        "showArrows": { "type": "boolean", "default": true },
        "showIndicators": { "type": "boolean", "default": true },
        "footnote": { "type": "string", "default": "" },
        "showFootnote": { "type": "boolean", "default": false },
        "spacingResponsive": { "type": "object", "default": {} },
        "width": { "type": "string", "default": "wide" },
        "background": { "type": "string", "default": "white" },
        "backgroundImage": { "type": "integer", "default": 0 },
        "backgroundImageUrl": { "type": "string", "default": "" },
        "backgroundImageFit": { "type": "string", "default": "cover" },
        "backgroundImagePosition": { "type": "string", "default": "center" },
        "backgroundOverlay": { "type": "string", "default": "none" },
        "textSize": { "type": "string", "default": "auto" },
        "textColor": { "type": "string", "default": "auto" },
        "textStyles": { "type": "object", "default": {} },
        "align": { "type": "string", "default": "full" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "viewScript": "file:./view.js"
}
