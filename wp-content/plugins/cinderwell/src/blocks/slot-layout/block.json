{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/slot-layout",
    "title": "Slot Layout",
    "category": "cinderwell",
    "icon": "layout",
    "description": "Build advanced layouts from a controlled set of content slots.",
    "supports": {
        "align": [ "wide", "full" ],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "slots": { "type": "array", "default": [] },
        "headingLevel": { "type": "integer", "default": 2 },
        "columns": { "type": "string", "default": "2" },
        "columnsTablet": { "type": "string", "default": "" },
        "columnsMobile": { "type": "string", "default": "" },
        "gap": { "type": "string", "default": "sm" },
        "spacingResponsive": { "type": "object", "default": {} },
        "width": { "type": "string", "default": "wide" },
        "background": { "type": "string", "default": "white" },
        "backgroundImage": { "type": "integer", "default": 0 },
        "backgroundImageUrl": { "type": "string", "default": "" },
        "backgroundImageFit": { "type": "string", "default": "cover" },
        "backgroundImagePosition": { "type": "string", "default": "center" },
        "backgroundOverlay": { "type": "string", "default": "none" },
        "textSize": { "type": "string", "default": "auto" },
        "textColor": { "type": "string", "default": "auto" },
        "textStyles": { "type": "object", "default": {} },
        "align": { "type": "string", "default": "full" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
