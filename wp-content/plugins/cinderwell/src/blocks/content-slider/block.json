{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cinderwell/content-slider",
  "title": "Content Slider",
  "category": "cinderwell-content",
  "icon": "slides",
  "description": "Accessible story slider pairing structured copy, actions, and synchronized media.",
  "supports": {
    "align": [ "wide", "full" ],
    "anchor": false,
    "color": false,
    "typography": false,
    "spacing": false,
    "border": false,
    "customClassName": true,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "attributes": {
    "dynamicData": { "type": "object", "default": {} },
    "conditions": { "type": "object", "default": {} },
    "visibility": { "type": "string", "default": "always" },
    "visibilityConfig": { "type": "object", "default": {} },
    "eyebrow": { "type": "string", "default": "" },
    "showEyebrow": { "type": "boolean", "default": false },
    "heading": { "type": "string", "default": "" },
    "showHeading": { "type": "boolean", "default": true },
    "headingLevel": { "type": "integer", "default": 2 },
    "slides": { "type": "array", "default": [] },
    "imageFit": { "type": "string", "default": "cover" },
    "imageAspect": { "type": "string", "default": "landscape" },
    "showIndicators": { "type": "boolean", "default": true },
    "spacingResponsive": { "type": "object", "default": {} },
    "width": { "type": "string", "default": "wide" },
    "background": { "type": "string", "default": "white" },
    "backgroundImage": { "type": "integer", "default": 0 },
    "backgroundImageUrl": { "type": "string", "default": "" },
    "backgroundImageFit": { "type": "string", "default": "cover" },
    "backgroundImagePosition": { "type": "string", "default": "center" },
    "backgroundOverlay": { "type": "string", "default": "none" },
    "textSize": { "type": "string", "default": "auto" },
    "textColor": { "type": "string", "default": "auto" },
    "textStyles": { "type": "object", "default": {} },
    "align": { "type": "string", "default": "full" }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
