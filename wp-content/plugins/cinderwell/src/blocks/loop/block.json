{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/loop",
    "title": "Loop",
    "category": "cinderwell",
    "icon": "screenoptions",
    "description": "Display a curated, responsive loop of posts or custom post types.",
    "supports": {
        "align": ["wide", "full"],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
        "dynamicData": { "type": "object", "default": {} },
        "conditions": { "type": "object", "default": {} },
        "visibility": { "type": "string", "default": "always" },
        "visibilityConfig": { "type": "object", "default": {} },
        "eyebrow": { "type": "string", "default": "" },
        "showEyebrow": { "type": "boolean", "default": false },
        "heading": { "type": "string", "default": "Latest posts" },
        "showHeading": { "type": "boolean", "default": true },
        "headingLevel": { "type": "integer", "default": 2 },
        "itemHeadingLevel": { "type": "integer", "default": 3 },
        "postType": { "type": "string", "default": "post" },
        "taxonomy": { "type": "string", "default": "" },
        "termId": { "type": "integer", "default": 0 },
        "postsPerPage": { "type": "integer", "default": 6 },
        "order": { "type": "string", "default": "desc" },
        "orderBy": { "type": "string", "default": "date" },
        "columns": { "type": "string", "default": "3" },
        "columnsTablet": { "type": "string", "default": "2" },
        "columnsMobile": { "type": "string", "default": "1" },
        "showFeaturedImage": { "type": "boolean", "default": true },
        "imageAspect": { "type": "string", "default": "landscape" },
        "showDate": { "type": "boolean", "default": true },
        "showTerms": { "type": "boolean", "default": false },
        "showExcerpt": { "type": "boolean", "default": true },
        "excerptLength": { "type": "integer", "default": 24 },
        "showReadMore": { "type": "boolean", "default": true },
        "readMoreLabel": { "type": "string", "default": "Read more" },
        "showPagination": { "type": "boolean", "default": false },
        "emptyMessage": { "type": "string", "default": "No items found." },
        "spacingResponsive": { "type": "object", "default": {} },
        "width": { "type": "string", "default": "wide" },
        "background": { "type": "string", "default": "white" },
        "backgroundImage": { "type": "integer", "default": 0 },
        "backgroundImageUrl": { "type": "string", "default": "" },
        "backgroundImageFit": { "type": "string", "default": "cover" },
        "backgroundImagePosition": { "type": "string", "default": "center" },
        "backgroundOverlay": { "type": "string", "default": "none" },
        "textSize": { "type": "string", "default": "auto" },
        "textColor": { "type": "string", "default": "auto" },
        "textStyles": { "type": "object", "default": {} },
        "align": { "type": "string", "default": "full" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}
