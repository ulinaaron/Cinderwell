{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/cta",
    "title": "CTA",
    "category": "cinderwell",
    "icon": "megaphone",
    "description": "Call-to-action section with eyebrow, heading, body, buttons, and footnote.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
        "visibilityConfig": {
            "type": "object",
            "default": {}
        },
        "layout": {
            "type": "string",
            "default": "standard"
        },
        "eyebrow": {
            "type": "string",
            "default": ""
        },
        "showEyebrow": {
            "type": "boolean",
            "default": false
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "showHeading": {
            "type": "boolean",
            "default": true
        },
        "headingLevel": { "type": "integer", "default": 2 },
        "bodyContent": {
            "type": "string",
            "default": ""
        },
        "showBody": {
            "type": "boolean",
            "default": false
        },
        "constrainCopyWidth": {
            "type": "boolean",
            "default": true
        },
        "buttons": {
            "type": "array",
            "default": []
        },
        "footnote": {
            "type": "string",
            "default": ""
        },
        "showFootnote": {
            "type": "boolean",
            "default": false
        },
        "spacingResponsive": {
            "type": "object",
            "default": {}
        },
        "width": {
            "type": "string",
            "default": "standard"
        },
        "background": {
            "type": "string",
            "default": "white"
        },
        "backgroundImage": { "type": "integer", "default": 0 },
        "backgroundImageUrl": { "type": "string", "default": "" },
        "backgroundImageFit": { "type": "string", "default": "cover" },
        "backgroundImagePosition": { "type": "string", "default": "center" },
        "backgroundOverlay": { "type": "string", "default": "none" },
        "textSize": {
            "type": "string",
            "default": "auto"
        },
        "textColor": {
            "type": "string",
            "default": "auto"
        },
        "textStyles": {
            "type": "object",
            "default": {}
        },
        "alignment": {
            "type": "string",
            "default": "center"
        },
        "align": {
            "type": "string",
            "default": "full"
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
