{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cinderwell/header-search",
  "title": "Header Search",
  "category": "cinderwell",
  "icon": "search",
  "description": "Accessible search disclosure for a site header.",
  "textdomain": "cinderwell",
  "supports": {
    "align": false,
    "anchor": false,
    "color": false,
    "customClassName": false,
    "html": false,
    "multiple": false,
    "reusable": false,
    "spacing": false,
    "typography": false
  },
  "attributes": {
    "label": { "type": "string", "default": "Search" },
    "placeholder": { "type": "string", "default": "Search the site" },
    "buttonText": { "type": "string", "default": "Search" }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
