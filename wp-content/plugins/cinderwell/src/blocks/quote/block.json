{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/quote",
    "title": "Quote",
    "category": "cinderwell",
    "icon": "format-quote",
    "description": "Blockquote with attribution, byline, and context.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "quote": {
            "type": "string",
            "default": ""
        },
        "attribution": {
            "type": "string",
            "default": ""
        },
        "byline": {
            "type": "string",
            "default": ""
        },
        "showByline": {
            "type": "boolean",
            "default": false
        },
        "context": {
            "type": "string",
            "default": ""
        },
        "showContext": {
            "type": "boolean",
            "default": false
        },
        "spacingResponsive": {
            "type": "object",
            "default": {}
        },
        "width": {
            "type": "string",
            "default": "standard"
        },
        "background": {
            "type": "string",
            "default": "white"
        },
        "backgroundImage": { "type": "integer", "default": 0 },
        "backgroundImageUrl": { "type": "string", "default": "" },
        "backgroundImageFit": { "type": "string", "default": "cover" },
        "backgroundImagePosition": { "type": "string", "default": "center" },
        "backgroundOverlay": { "type": "string", "default": "none" },
        "textSize": {
            "type": "string",
            "default": "auto"
        },
        "textColor": {
            "type": "string",
            "default": "auto"
        },
        "textStyles": {
            "type": "object",
            "default": {}
        },
        "alignment": {
            "type": "string",
            "default": "left"
        },
        "align": {
            "type": "string",
            "default": "wide"
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
