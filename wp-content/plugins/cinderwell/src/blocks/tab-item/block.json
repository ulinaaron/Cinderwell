{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/tab-item",
    "title": "Tab Item",
    "category": "cinderwell",
    "icon": "index-card",
    "description": "A tab label with a block-based content area.",
    "parent": [ "cinderwell/tabs" ],
    "supports": {
        "align": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "reusable": false
    },
    "attributes": {
        "label": { "type": "string", "default": "" }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css"
}
