{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cinderwell/columns",
  "title": "Columns",
  "category": "cinderwell",
  "icon": "columns",
  "description": "A responsive layout whose columns accept Cinderwell blocks.",
  "allowedBlocks": ["cinderwell/column"],
  "supports": {
    "align": ["wide", "full"],
    "align_text": false,
    "align_content": false,
    "color": false,
    "typography": false,
    "spacing": false,
    "border": false,
    "anchor": false,
    "customClassName": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "attributes": {
    "layout": { "type": "string", "default": "standard" },
    "conditions": { "type": "object", "default": {} },
    "visibility": { "type": "string", "default": "always" },
    "visibilityConfig": { "type": "object", "default": {} },
    "gap": { "type": "string", "default": "md" },
    "stackAt": { "type": "string", "default": "mobile" },
    "reverseOnMobile": { "type": "boolean", "default": false },
    "verticalAlignment": { "type": "string", "default": "stretch" },
    "spacingResponsive": { "type": "object", "default": {} },
    "width": { "type": "string", "default": "wide" },
    "background": { "type": "string", "default": "white" },
    "backgroundImage": { "type": "integer", "default": 0 },
    "backgroundImageUrl": { "type": "string", "default": "" },
    "backgroundImageFit": { "type": "string", "default": "cover" },
    "backgroundImagePosition": { "type": "string", "default": "center" },
    "backgroundOverlay": { "type": "string", "default": "none" },
    "childBackgroundMode": { "type": "string", "default": "inherit" },
    "align": { "type": "string", "default": "full" }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
