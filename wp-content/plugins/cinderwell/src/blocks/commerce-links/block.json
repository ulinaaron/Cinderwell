{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/commerce-links",
    "version": "0.1.0",
    "title": "Commerce Links",
    "category": "cinderwell",
    "icon": "cart",
    "description": "Lightweight account and cart links for a site header.",
    "textdomain": "cinderwell",
    "attributes": {
        "showAccount": {
            "type": "boolean",
            "default": true
        },
        "showCart": {
            "type": "boolean",
            "default": true
        },
        "showCount": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "inserter": true,
        "reusable": false
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}
