{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/map",
    "title": "Map",
    "category": "cinderwell-media",
    "icon": "location-alt",
    "description": "Display one or more locations on an OpenStreetMap map.",
    "supports": {
        "align": ["wide", "full"],
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
        "source": { "type": "string", "default": "manual" },
        "mode": { "type": "string", "default": "single" },
        "locations": { "type": "array", "default": [] },
        "locationTerm": { "type": "integer", "default": 0 },
        "presentation": { "type": "string", "default": "map" },
        "enableSearch": { "type": "boolean", "default": false },
        "enableGeolocation": { "type": "boolean", "default": false },
        "searchLabel": { "type": "string", "default": "Search locations" },
        "geolocationLabel": { "type": "string", "default": "Use my location" },
        "emptyLabel": { "type": "string", "default": "No locations match your search." },
        "mapLabel": { "type": "string", "default": "Location map" },
        "directionsLabel": { "type": "string", "default": "Get directions" },
        "openPopup": { "type": "boolean", "default": true },
        "zoom": { "type": "integer", "default": 14 },
        "height": { "type": "string", "default": "medium" },
        "spacingResponsive": { "type": "object", "default": {} },
        "width": { "type": "string", "default": "wide" },
        "align": { "type": "string", "default": "full" }
    },
    "editorScript": "file:./index.js",
    "style": ["cinderwell-leaflet", "cinderwell-forms", "file:./style.css"],
    "editorStyle": ["cinderwell-leaflet", "file:./editor.css"],
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}
