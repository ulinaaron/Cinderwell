{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/gravity-form",
    "title": "Gravity Form",
    "category": "cinderwell",
    "icon": "feedback",
    "description": "Embed a Gravity Forms form with Cinderwell design token styling.",
    "supports": {
        "align": ["wide", "full"], "align_text": false, "align_content": false,
        "color": false, "typography": false, "spacing": false,
        "border": false, "anchor": false, "customClassName": false,
        "html": false, "multiple": true, "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
        },
        "formId": { "type": "number", "default": 0 },
        "description": { "type": "boolean", "default": true },
        "ajax": { "type": "boolean", "default": true },
        "width": { "type": "string", "default": "standard" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}
