{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cinderwell/icon-list",
  "title": "Icon List",
  "category": "cinderwell",
  "icon": "editor-ul",
  "description": "A semantic list with a shared default icon and per-item icon overrides.",
  "supports": {
    "align": ["wide", "full"],
    "align_text": false,
    "align_content": false,
    "color": false,
    "typography": false,
    "spacing": false,
    "border": false,
    "anchor": false,
    "customClassName": false,
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "attributes": {
    "dynamicData": { "type": "object", "default": {} },
    "conditions": { "type": "object", "default": {} },
    "visibility": { "type": "string", "default": "always" },
    "visibilityConfig": { "type": "object", "default": {} },
    "defaultIcon": { "type": "string", "default": "check" },
    "defaultIconSource": { "type": "string", "default": "library" },
    "defaultIconSvg": { "type": "string", "default": "" },
    "defaultIconViewBox": { "type": "string", "default": "0 0 24 24" },
    "defaultIconSvgId": { "type": "integer", "default": 0 },
    "defaultIconSvgUrl": { "type": "string", "default": "" },
    "iconSize": { "type": "string", "default": "md" },
    "iconColor": { "type": "string", "default": "brand" },
    "iconTreatment": { "type": "string", "default": "plain" },
    "gap": { "type": "string", "default": "standard" }
  },
  "providesContext": {
    "cinderwell/iconListDefaultIcon": "defaultIcon",
    "cinderwell/iconListDefaultIconSource": "defaultIconSource",
    "cinderwell/iconListDefaultIconSvg": "defaultIconSvg",
    "cinderwell/iconListDefaultIconViewBox": "defaultIconViewBox",
    "cinderwell/iconListDefaultIconSvgId": "defaultIconSvgId",
    "cinderwell/iconListDefaultIconSvgUrl": "defaultIconSvgUrl"
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
