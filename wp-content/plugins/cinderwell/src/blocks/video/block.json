{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/video",
    "title": "Video",
    "category": "cinderwell",
    "icon": "video-alt3",
    "description": "Responsive uploaded or embedded video with accessible playback options.",
    "supports": {
        "align": [ "wide", "full" ],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
        "sourceType": { "type": "string", "default": "upload" },
        "videoId": { "type": "integer", "default": 0 },
        "videoUrl": { "type": "string", "default": "" },
        "embedUrl": { "type": "string", "default": "" },
        "posterId": { "type": "integer", "default": 0 },
        "posterUrl": { "type": "string", "default": "" },
        "caption": { "type": "string", "default": "" },
        "captionsUrl": { "type": "string", "default": "" },
        "captionsLabel": { "type": "string", "default": "English" },
        "captionsLanguage": { "type": "string", "default": "en" },
        "controls": { "type": "boolean", "default": true },
        "autoplay": { "type": "boolean", "default": false },
        "loop": { "type": "boolean", "default": false },
        "muted": { "type": "boolean", "default": false },
        "preload": { "type": "string", "default": "metadata" },
        "aspect": { "type": "string", "default": "wide" },
        "fit": { "type": "string", "default": "contain" },
        "width": { "type": "string", "default": "wide" },
        "spacingResponsive": { "type": "object", "default": {} },
        "align": { "type": "string", "default": "full" },
        "dynamicData": { "type": "object", "default": {} },
        "conditions": { "type": "object", "default": {} },
        "visibility": { "type": "string", "default": "always" },
        "visibilityConfig": { "type": "object", "default": {} }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}
