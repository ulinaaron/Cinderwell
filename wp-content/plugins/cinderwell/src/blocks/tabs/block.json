{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/tabs",
    "title": "Tabs",
    "category": "cinderwell",
    "icon": "index-card",
    "description": "Accessible tabbed content with block-based panels and responsive navigation.",
    "supports": {
        "align": [ "wide", "full" ],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "eyebrow": { "type": "string", "default": "" },
        "showEyebrow": { "type": "boolean", "default": false },
        "heading": { "type": "string", "default": "" },
        "showHeading": { "type": "boolean", "default": true },
        "headingLevel": { "type": "integer", "default": 2 },
        "footnote": { "type": "string", "default": "" },
        "showFootnote": { "type": "boolean", "default": false },
        "tabStyle": { "type": "string", "default": "underline" },
        "orientation": { "type": "string", "default": "horizontal" },
        "orientationTablet": { "type": "string", "default": "auto" },
        "orientationMobile": { "type": "string", "default": "vertical" },
        "verticalSide": { "type": "string", "default": "left" },
        "tabPosition": { "type": "string", "default": "start" },
        "tabPositionTablet": { "type": "string", "default": "auto" },
        "tabPositionMobile": { "type": "string", "default": "stretch" },
        "spacingResponsive": { "type": "object", "default": {} },
        "width": { "type": "string", "default": "standard" },
        "background": { "type": "string", "default": "white" },
        "backgroundImage": { "type": "integer", "default": 0 },
        "backgroundImageUrl": { "type": "string", "default": "" },
        "backgroundImageFit": { "type": "string", "default": "cover" },
        "backgroundImagePosition": { "type": "string", "default": "center" },
        "backgroundOverlay": { "type": "string", "default": "none" },
        "childBackgroundMode": { "type": "string", "default": "inherit" },
        "textSize": { "type": "string", "default": "auto" },
        "textColor": { "type": "string", "default": "auto" },
        "textStyles": { "type": "object", "default": {} },
        "align": { "type": "string", "default": "wide" }
    },
    "editorScript": "file:./index.js",
    "render": "file:./render.php",
    "viewScript": "file:./view.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
