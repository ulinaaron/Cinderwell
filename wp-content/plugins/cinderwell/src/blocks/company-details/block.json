{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/company-details",
    "title": "Company Details",
    "category": "cinderwell-content",
    "icon": "building",
    "description": "Display reusable contact, address, and business-hours information.",
    "supports": {
        "align": ["wide", "full"],
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
        "contentMode": { "type": "string", "default": "hours" },
        "layout": { "type": "string", "default": "card" },
        "heading": { "type": "string", "default": "" },
        "showHeading": { "type": "boolean", "default": true },
        "headingLevel": { "type": "integer", "default": 2 },
        "showDescription": { "type": "boolean", "default": false },
        "showAddress": { "type": "boolean", "default": true },
        "showPhone": { "type": "boolean", "default": true },
        "showEmail": { "type": "boolean", "default": false },
        "showHours": { "type": "boolean", "default": true },
        "showStatus": { "type": "boolean", "default": true },
        "showContact": { "type": "boolean", "default": true },
        "showDirections": { "type": "boolean", "default": false },
        "contactLabel": { "type": "string", "default": "Contact us" },
        "directionsLabel": { "type": "string", "default": "Get directions" },
        "alignment": { "type": "string", "default": "left" },
        "spacingResponsive": { "type": "object", "default": {} },
        "width": { "type": "string", "default": "standard" },
        "background": { "type": "string", "default": "light" },
        "textSize": { "type": "string", "default": "auto" },
        "textColor": { "type": "string", "default": "auto" },
        "textStyles": { "type": "object", "default": {} },
        "align": { "type": "string", "default": "full" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}
