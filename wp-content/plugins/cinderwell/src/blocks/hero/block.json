{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/hero",
    "title": "Hero",
    "category": "cinderwell",
    "icon": "cover-image",
    "description": "Page-level hero with eyebrow, heading, image, and buttons. Supports full-bleed background images.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "eyebrow": {
            "type": "string",
            "default": ""
        },
        "showEyebrow": {
            "type": "boolean",
            "default": false
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "showHeading": {
            "type": "boolean",
            "default": true
        },
        "headingLevel": { "type": "integer", "default": 1 },
        "subheading": {
            "type": "string",
            "default": ""
        },
        "showSubheading": {
            "type": "boolean",
            "default": false
        },
        "bgImage": {
            "type": "integer",
            "default": 0
        },
        "bgImageUrl": {
            "type": "string",
            "default": ""
        },
        "bgImageFit": {
            "type": "string",
            "default": "auto"
        },
        "bgImagePosition": {
            "type": "string",
            "default": "center"
        },
        "bgImageAlt": {
            "type": "string",
            "default": ""
        },
        "showBgImage": {
            "type": "boolean",
            "default": false
        },
        "bgOverlay": {
            "type": "boolean",
            "default": true
        },
        "bgOverlayPreset": {
            "type": "string",
            "default": "medium"
        },
        "image": {
            "type": "integer",
            "default": 0
        },
        "imageUrl": {
            "type": "string",
            "default": ""
        },
        "imageFit": {
            "type": "string",
            "default": "auto"
        },
        "imagePosition": {
            "type": "string",
            "default": "center"
        },
        "imageSide": {
            "type": "string",
            "default": "right"
        },
        "splitGap": {
            "type": "string",
            "default": "md"
        },
        "imageAspect": {
            "type": "string",
            "default": "auto"
        },
        "imageAlt": {
            "type": "string",
            "default": ""
        },
        "showImage": {
            "type": "boolean",
            "default": false
        },
        "caption": {
            "type": "string",
            "default": ""
        },
        "showCaption": {
            "type": "boolean",
            "default": false
        },
        "buttons": {
            "type": "array",
            "default": []
        },
        "footnote": {
            "type": "string",
            "default": ""
        },
        "showFootnote": {
            "type": "boolean",
            "default": false
        },
        "layout": {
            "type": "string",
            "default": "split"
        },
        "spacingResponsive": {
            "type": "object",
            "default": {}
        },
        "width": {
            "type": "string",
            "default": "standard"
        },
        "background": {
            "type": "string",
            "default": "white"
        },
        "textSize": {
            "type": "string",
            "default": "auto"
        },
        "textColor": {
            "type": "string",
            "default": "auto"
        },
        "textStyles": {
            "type": "object",
            "default": {}
        },
        "alignment": {
            "type": "string",
            "default": "center"
        },
        "align": {
            "type": "string",
            "default": "full"
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
