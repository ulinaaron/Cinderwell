{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/button",
    "title": "Button",
    "category": "cinderwell",
    "icon": "button",
    "description": "Styled button with variant (primary/secondary/ghost/link) and size (sm/md/lg) options.",
    "supports": {
        "align": ["wide", "full"], "align_text": false, "align_content": false,
        "color": false, "typography": false, "spacing": false,
        "border": false, "anchor": false, "customClassName": false,
        "html": false, "multiple": true, "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "text": { "type": "string", "default": "" },
        "url": { "type": "string", "default": "" },
        "urlDynamic": { "type": "object", "default": {} },
        "opensInNewTab": { "type": "boolean", "default": false },
        "variant": { "type": "string", "default": "primary" },
        "size": { "type": "string", "default": "md" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
