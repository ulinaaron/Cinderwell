{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/note",
    "title": "Note",
    "category": "cinderwell",
    "icon": "editor-quote",
    "description": "Standalone note block with styles: disclaimer, caption, footnote, legal.",
    "supports": {
        "align": ["wide", "full"], "align_text": false, "align_content": false,
        "color": false, "typography": false, "spacing": false,
        "border": false, "anchor": false, "customClassName": false,
        "html": false, "multiple": true, "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "content": { "type": "string", "default": "" },
        "style": { "type": "string", "default": "disclaimer" },
        "textSize": { "type": "string", "default": "auto" },
        "textColor": { "type": "string", "default": "auto" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
