{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/number",
    "title": "Number",
    "category": "cinderwell",
    "icon": "chart-bar",
    "description": "A statistic or measurable result with an optional count-up animation.",
    "supports": {
        "align": false,
        "align_text": false,
        "align_content": false,
        "color": false,
        "typography": false,
        "spacing": false,
        "border": false,
        "anchor": false,
        "customClassName": false,
        "html": false,
        "multiple": true,
        "reusable": true
    },
    "attributes": {
        "dynamicData": { "type": "object", "default": {} },
        "conditions": { "type": "object", "default": {} },
        "visibility": { "type": "string", "default": "always" },
        "visibilityConfig": { "type": "object", "default": {} },
        "value": { "type": "string", "default": "100" },
        "prefix": { "type": "string", "default": "" },
        "suffix": { "type": "string", "default": "" },
        "label": { "type": "string", "default": "Measurable result" },
        "size": { "type": "string", "default": "lg" },
        "alignment": { "type": "string", "default": "left" },
        "animate": { "type": "boolean", "default": true },
        "animationDuration": { "type": "string", "default": "standard" }
    },
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
