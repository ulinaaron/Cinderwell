{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/image",
    "title": "Image",
    "category": "cinderwell",
    "icon": "format-image",
    "description": "Standalone image block with required alt text.",
    "supports": {
        "align": ["wide", "full"], "align_text": false, "align_content": false,
        "color": false, "typography": false, "spacing": false,
        "border": false, "anchor": false, "customClassName": false,
        "html": false, "multiple": true, "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "imageId": { "type": "integer", "default": 0 },
        "imageUrl": { "type": "string", "default": "" },
        "imageFit": { "type": "string", "default": "auto" },
        "imagePosition": { "type": "string", "default": "center" },
        "imageAspect": { "type": "string", "default": "auto" },
        "imageAlt": { "type": "string", "default": "" },
        "caption": { "type": "string", "default": "" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
