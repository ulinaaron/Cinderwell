{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell/divider",
    "title": "Divider",
    "category": "cinderwell",
    "icon": "minus",
    "description": "Visual separator with weight options.",
    "supports": {
        "align": ["wide", "full"], "align_text": false, "align_content": false,
        "color": false, "typography": false, "spacing": false,
        "border": false, "anchor": false, "customClassName": false,
        "html": false, "multiple": true, "reusable": true
    },
    "attributes": {
		"dynamicData": {
			"type": "object",
			"default": {}
		},
		"conditions": {
			"type": "object",
			"default": {}
		},
		"visibility": {
			"type": "string",
			"default": "always"
		},
		"visibilityConfig": {
			"type": "object",
			"default": {}
		},
        "weight": { "type": "string", "default": "light" }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
