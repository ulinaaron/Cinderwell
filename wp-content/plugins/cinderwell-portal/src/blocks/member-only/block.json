{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cinderwell-portal/member-only",
    "title": "Member Only",
    "category": "cinderwell-portal",
    "icon": "visibility",
    "description": "Wrap content to show only to logged-in members.",
    "supports": {
        "align": false,
        "color": false,
        "typography": false,
        "html": false
    },
    "attributes": {
        "fallbackMessage": { "type": "string", "default": "This content is for members only." },
        "fallbackShowLoginLink": { "type": "boolean", "default": true }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
